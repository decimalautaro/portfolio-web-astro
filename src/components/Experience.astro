---
import ExperienceItem from "../components/ExperienceItem.astro";

const EXPERIENCE = [
  {
    date: "Abril 2026 - Actualidad",
    title: "Lead Engineer - NTT DATA",
    description: [
      "Desarrollo y modernización de la arquitectura frontend para el <b>E-commerce de la cervecería Mahou San Miguel (España)</b>.",
      "<b><u>Arquitectura y Design System:</u></b>",
      "Adaptación y evolución del <b>Design System desarrollado con Stencil</b> para garantizar su compatibilidad y correcto funcionamiento en entornos con <b>Server-Side Rendering (SSR)</b>.",
      "Creación de <b>wrappers dinámicos</b> para el consumo de componentes tanto como Web Components tradicionales como <b>React Server Components</b> en arquitecturas de Next.js.",
      "Actualización y mantenimiento evolutivo de componentes del sistema de diseño, garantizando su paridad con las últimas definiciones y prototipos en <b>Figma</b>.",
      "Optimización e integración de componentes para asegurar un rendimiento y experiencia de usuario consistente en aplicaciones web híbridas desarrolladas con <b>Capacitor</b>.",
      "<b><u>Microfrontends y Frameworks:</u></b>",
      "Implementación de <b>Microfrontends mediante Module Federation</b>, facilitando una arquitectura modular y escalable para el ecosistema del e-commerce.",
    ],
  },
  {
    date: "Noviembre 2023 - Abril 2026",
    title: "Software Engineer - NTT DATA",
    description: [
      "Responsable del desarrollo y optimización de la arquitectura backend y frontend del <b>sistema CRM de Movistar</b>, trabajando con tecnologías modernas bajo un enfoque de microservicios y desarrollo fullstack. ",
      "<b><u>Backend:</u></b>",
      "Diseño e implementación de microservicios en una arquitectura desacoplada utilizando lógica de negocio distribuida y exposición de servicios REST.",
      "Gestión de persistencia con SQL y NoSQL (MongoDB), optimizando stored procedures para alto rendimiento y escalabilidad.",
      "Incorporación de estrategias de caché distribuida (Data Grid) para reducir latencia en microservicios de alta concurrencia.",
      "Automatización de pipelines CI/CD en OpenShift y monitoreo proactivo con Kibana y Dynatrace.",
      "<b><u>Frontend:</u></b>",
      "Desarrollo funcional con React y TypeScript, implementando arquitecturas basadas en Context API y hooks personalizados.",
      "Implementación de feature flags dinámicas para controlar el despliegue de funcionalidades en entornos de integración, certificación y producción.",
    ],
  },
  {
    date: "Agosto 2022 - Septiembre 2023",
    title: "Backend Developer - Bitionz",
    description: [
      "Desarrollo de APIs REST utilizando TypeScript, Node.js, Express.js y SQL Server.",
      "Manejo de librerías como bcryptjs, jsonwebtoken, nodemailer, entre otras.",
      "Despliegue y configuración avanzada de APIs con Docker, incluyendo el uso de docker-compose para orquestar múltiples servicios (base de datos, backend, etc.) en entornos de desarrollo y producción.",
      "Integración con servicios externos, como la API de Mercado Pago, para gestionar procesos de pago de forma segura y eficiente.",
      "Gestión de bases de datos: Diseño, modelado, mantenimiento y consultas complejas en SQL Server. ",
      "Documentación técnica del backend y de las APIs usando Postman y Swagger.",
      "Mantenimiento y solución de errores de la web Argentina MINING usando NestJS, Next.js, TypeORM y PostgreSQL.",
    ],
  },
  {
    date: "Junio 2021 - Agosto 2022",
    title: "Soporte Técnico IT - Inmobiliaria Cocucci S.A",
    description: [
      "Instalación y mantenimiento preventivo de equipos informáticos.",
      "Asesoramiento general, instalación de software, documentación y seguimiento de errores.",
      "Resolución de problemas técnicos, incluyendo la reparación de equipos defectuosos.",
      "Monitoreo y supervisión de backups para resguardar la información.",
      "Mantenimiento de riesgos informáticos y medidas de seguridad.",
    ],
  },
];
---

<ol class="relative border-s border-gray-200 ml-3 md:ml-6">
  {
    EXPERIENCE.map((experience) => (
      <li class="mb-8 md:mb-10 ms-4">
        <ExperienceItem {...experience} />
      </li>
    ))
  }
</ol>
<br />
