---
import ExperienceItem from "../components/ExperienceItem.astro";

const EXPERIENCE = [
  {
    date: "Abril 2026 - Actualidad",
    title: "Lead Engineer - NTT DATA",
    description: [
      "Actualización y modernización de la arquitectura frontend del <b>E-commerce de la cervecería Mahou San Miguel (España)</b>.",
      "<b><u>Arquitectura y Design System:</u></b>",
      "Adaptación de <b>21 componentes (atoms, molecules y organisms)</b> del Design System basado en <b>Stencil</b> para habilitar su consumo desde una aplicación <b>Next.js con Server-Side Rendering (SSR)</b>.",
      "Creación de <b>wrappers dinámicos</b> para consumir componentes como <b>Web Components</b> desde <b>React Server Components</b> y aplicaciones React dentro de arquitecturas Next.js.",
      "Actualización y mantenimiento evolutivo de componentes con <b>Figma Design Tokens</b>, asegurando paridad con las definiciones y prototipos de diseño.",
      "Validación e integración de componentes en aplicaciones web híbridas con <b>Capacitor 8</b>, con foco en una experiencia consistente entre web y aplicación.",
      "<b><u>Calidad y entrega:</u></b>",
      "Pruebas unitarias, pruebas de interacción de componentes en <b>Storybook</b> y pruebas de contrato con <b>Playwright</b> para reforzar la calidad y compatibilidad de las integraciones.",
      "Implementación de <b>microfrontends mediante Module Federation</b>, favoreciendo modularidad y escalabilidad en el ecosistema de e-commerce.",
      "CI/CD con <b>GitHub Actions</b> y despliegue de contenedores en <b>Azure</b>.",
    ],
  },
  {
    date: "Noviembre 2023 - Abril 2026",
    title: "Software Engineer - NTT DATA",
    description: [
      "Diseño y evolución del backend y frontend del <b>sistema CRM de Movistar</b>, bajo un enfoque de microservicios y desarrollo fullstack.",
      "<b><u>Backend:</u></b>",
      "Diseño e implementación de microservicios desacoplados en <b>Node.js</b> y <b>TypeScript</b>, con lógica de negocio, APIs REST, acceso a datos e integración con servicios externos.",
      "Desarrollo del <b>módulo de contención</b>, habilitando a los representantes a ofrecer la alternativa comercial más adecuada durante la atención y contribuyendo a la retención de clientes.",
      "Modernización del <b>módulo de totalización</b>, reemplazando procesos basados en base de datos por integraciones mediante APIs para reducir acoplamiento y mejorar la mantenibilidad.",
      "Implementación del <b>módulo de eSIM</b> (envío de código QR por correo para su activación) y de las <b>notas de crédito</b> para clientes B2C y B2B.",
      "Desarrollo de capas DAO sobre bases SQL y NoSQL (<b>MongoDB</b> y <b>stored procedures</b> optimizados), incorporando caché con <b>Data Grid</b> para reducir latencia y accesos repetitivos.",
      "Automatización de despliegues con <b>CI/CD en OpenShift</b>, pruebas unitarias y de integración, gestión de secretos con <b>Vault</b> y <b>ConfigMaps</b>, y controles de calidad y seguridad con <b>SonarQube</b> y <b>AppScan</b>.",
      "Monitoreo, debugging y resolución de incidentes en producción con <b>Kibana</b> y <b>Dynatrace</b>, junto con <b>feature flags</b> por usuario y entorno para liberaciones graduales.",
      "<b><u>Frontend:</u></b>",
      "Desarrollo funcional con <b>React</b> y <b>TypeScript</b>, implementando arquitecturas basadas en Context API y hooks personalizados.",
    ],
  },
  {
    date: "Agosto 2022 - Septiembre 2023",
    title: "Backend Developer - Bitionz",
    description: [
      "Desarrollo de APIs backend con <b>TypeScript</b>, <b>Node.js</b>, <b>Express.js</b> y <b>SQL Server</b>.",
      "Implementación de autenticación y funcionalidades de seguridad con <b>bcryptjs</b>, <b>JSON Web Tokens (JWT)</b> y <b>nodemailer</b>.",
      "Integración de <b>Mercado Pago</b> y otros servicios externos, junto con diseño, creación y mantenimiento de bases de datos y consultas SQL.",
      "Documentación técnica de APIs con <b>Postman</b> y <b>Swagger/OpenAPI</b>.",
      "Mantenimiento correctivo y evolutivo de una aplicación web con <b>NestJS</b>, <b>Next.js</b>, <b>TypeORM</b> y <b>PostgreSQL</b>.",
    ],
  },
];
---

<ol class="relative border-s border-gray-200 ml-2 md:ml-6">
  {
    EXPERIENCE.map((experience) => (
      <li class="mb-8 md:mb-10 ms-4">
        <ExperienceItem {...experience} />
      </li>
    ))
  }
</ol>
<br />
